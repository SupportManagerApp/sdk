{
    "name": "supportmanager/sdk",
    "description": "PHP client SDK for the SupportManager backend API — authentication, session, and tenant-scoped module requests shared across first-party apps.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/config": "^11.0 || ^12.0 || ^13.0",
        "illuminate/container": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "SupportManager\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SupportManager\\Sdk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SupportManager\\Sdk\\SdkServiceProvider"
            ],
            "aliases": {
                "SupportManager": "SupportManager\\Sdk\\Facades\\SupportManager"
            }
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "sync-openapi": "@php bin/sync-openapi",
        "test": "pest"
    },
    "scripts-descriptions": {
        "sync-openapi": "Regenerate tests/Contract/openapi.yaml from a platform checkout (path argument or SUPPORTMANAGER_PLATFORM_PATH)."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
